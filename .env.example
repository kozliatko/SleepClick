# Domain served by caddy-docker-proxy
CADDY_DOMAIN=sleep.example.com

# Shared secret for /api/sessions. The same value goes into the watch app
# settings (Garmin Connect > SleepClick > Settings) and into the PWA.
# Must be at least 16 characters — the backend refuses to start otherwise.
# Generate one with:  openssl rand -hex 32
SYNC_TOKEN=change-me-to-a-long-random-string

# Web admin at /admin (token management). Leave blank to disable it entirely.
# Password must be at least 12 characters or the admin stays off.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long
