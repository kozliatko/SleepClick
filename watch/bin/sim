#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PRJ="${SCRIPT_DIR}/.."
SDK="/home/developer/opt/connectiq-sdk/bin"

if [ ! -f /tmp/libsoup-3.0.so.0 ] || [ ! -f /tmp/libsoup-2.4.so.1 ]; then
    echo "Zostavujem patched libsoup..."
    "${SCRIPT_DIR}/build-stub"
fi

echo "Spúšťam simulátor..."
LD_LIBRARY_PATH=/tmp:"${LD_LIBRARY_PATH}" "${SDK}/simulator" &
SIM_PID=$!

# Čakaj kým simulátor otvorí socket (max 20s)
for i in $(seq 1 20); do
    sleep 1
    if ! kill -0 "$SIM_PID" 2>/dev/null; then
        echo "CHYBA: simulátor (PID=$SIM_PID) padol po ${i}s."
        exit 1
    fi
    # Skús pripojiť monkeydo; ticho ak ešte nie je ready
    if "${SDK}/monkeydo" "${PRJ}/build/SleepClick.prg" fr935 2>/dev/null; then
        echo "OK — app nahratá po ${i}s. Zavri simulátor: kill $SIM_PID"
        exit 0
    fi
    echo -n "."
done

echo ""
echo "CHYBA: monkeydo sa nevedel pripojiť ani po 20s (PID=$SIM_PID stále beží)."
echo "Skontroluj DISPLAY: echo \$DISPLAY"
exit 1
